# ============================================
# 本地开发环境配置示例
# ============================================
# 此配置用于本地开发，连接 Docker 中的服务
# 使用方法：
# 1. 复制此文件为 .env
#    cp env.local.example .env
# 2. 启动 Docker 服务
#    bash scripts/shell/start_dev_env.sh
# 3. 启动 Backend 和 Frontend
# ============================================

# ==================== 应用基础配置 ====================
APP_NAME=园区综合能源管理系统
APP_VERSION=2.2.0
DEBUG=True

# ==================== 数据库配置 ====================
# 连接到 Docker 中的 TimescaleDB（localhost:5432）
DATABASE_URL=postgresql://admin:password123@localhost:5432/campus_energy

# ==================== Redis配置 ====================
# 连接到 Docker 中的 Redis（localhost:6379）
REDIS_URL=redis://localhost:6379/0

# ==================== MQTT配置 ====================
# 连接到 Docker 中的 Mosquitto（TLS 8883，运行 gen_dev_mqtt_certs.sh 后填入）
MQTT_BROKER=localhost
MQTT_PORT=8883
MQTT_TLS_ENABLED=True
MQTT_TLS_CA_PATH=/absolute/path/to/mosquitto/config/certs/ca.crt
MQTT_TLS_INSECURE=False
MQTT_USERNAME=ingest-worker
MQTT_PASSWORD=<set-in-.env-from-gen-script>
MQTT_INGEST_USERNAME=ingest-worker
MQTT_INGEST_PASSWORD=<set-in-.env-from-gen-script>
MQTT_CONTROL_USERNAME=control-publisher
MQTT_CONTROL_PASSWORD=<set-in-.env-from-gen-script>
MQTT_TOPIC=campus/telemetry
MQTT_TOPIC_WILDCARD=campus/device/+/telemetry
MQTT_CONTROL_TOPIC_PREFIX=campus/control/

# ==================== JWT认证配置 ====================
SECRET_KEY=dev-secret-key-for-local-development-only-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=300

# ==================== CORS配置 ====================
# 允许本地前端访问
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]

# ==================== 电价配置 ====================
PEAK_PRICE=1.25
FLAT_PRICE=0.80
VALLEY_PRICE=0.40

# ==================== 故障诊断配置（FDD） ====================
FDD_VOLTAGE_FLUCTUATION_LIMIT=0.10
FDD_OVERLOAD_RATIO=0.90
FDD_RATED_POWER=1000.0
FDD_ALARM_THRESHOLD=10
FDD_FREQUENT_START_COUNT=5

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_RETENTION_DAYS=7

# ==================== 数据清理配置 ====================
# 本地联调默认短保留，避免历史流水和补偿遥测快速堆积
ENABLE_AUTO_CLEANUP=true
MQTT_INGESTION_RETENTION_DAYS=3
AUDIT_EVENT_RETENTION_DAYS=3
DATA_RETENTION_DAYS=7
ALARM_RETENTION_DAYS=180
STATISTICS_RETENTION_DAYS=365

# ==================== 服务器配置 ====================
HOST=0.0.0.0
PORT=8088
WORKERS=1
RELOAD=True  # 开发环境启用热重载

# ==================== 配置文件路径 ====================
CONFIG_DIR=config
