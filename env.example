# ============================================
# 煤矿能源管理系统 - 环境变量配置模板
# ============================================
# 使用方法：
# 1. 复制此文件为 .env
# 2. 根据实际情况修改配置值
# 3. 注意：.env 文件不要提交到版本控制系统！
# ============================================

# ==================== 应用基础配置 ====================
APP_NAME=煤矿综合能源管理系统
APP_VERSION=2.0.0
APP_ENV=development
DEBUG=False
STRICT_STARTUP_CHECKS=True

# ==================== 数据库配置 ====================
# 格式：postgresql://用户名:密码@主机:端口/数据库名
# 示例：postgresql://admin:password123@db:5432/mine_energy
DATABASE_URL=postgresql://admin:password123@db:5432/mine_energy
DB_AUTO_CREATE_TABLES=True
DB_RUNTIME_SCHEMA_SYNC=True

# ==================== Redis配置 ====================
# 格式：redis://[:密码@]主机:端口/数据库编号
# 示例：redis://redis:6379/0
REDIS_URL=redis://redis:6379/0
# REDIS_PASSWORD=your_redis_password  # 可选

# ==================== MQTT配置 ====================
MQTT_BROKER=mqtt
MQTT_PORT=1883
# MQTT_USERNAME=admin  # 可选
# MQTT_PASSWORD=123456  # 可选
MQTT_TOPIC=mine/telemetry
MQTT_TOPIC_WILDCARD=mine/device/+/telemetry
MQTT_RETRY_MAX_ATTEMPTS=3
MQTT_RETRY_BACKOFF_SECONDS=60

# ==================== JWT认证配置 ====================
# ⚠️ 重要：生产环境必须修改 SECRET_KEY！
# 建议使用以下命令生成强密钥：
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=300

# ==================== CORS配置 ====================
# 允许的前端来源（JSON数组格式或逗号分隔）
# 开发环境示例：["http://localhost:5173", "http://127.0.0.1:5173"]
# 生产环境示例：["https://yourdomain.com"]
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ==================== 电价配置 ====================
# 用于能耗成本计算（单位：元/kWh）
PEAK_PRICE=1.25
FLAT_PRICE=0.80
VALLEY_PRICE=0.40

# ==================== 故障诊断配置（FDD） ====================
# 电压波动阈值（单位：百分比，如0.10表示10%）
FDD_VOLTAGE_FLUCTUATION_LIMIT=0.10
# 负载率阈值（0-1之间，如0.90表示90%）
FDD_OVERLOAD_RATIO=0.90
# 设备额定功率（单位：kW，用于计算负载率）
FDD_RATED_POWER=1000.0
# 报警次数阈值（超过此值将影响健康评分）
FDD_ALARM_THRESHOLD=10
# 频繁启动次数阈值（单位时间内启动次数）
FDD_FREQUENT_START_COUNT=5

# ==================== 预测配置 ====================
# 预测时间范围（单位：小时）
FORECAST_HORIZON_HOURS=24
# 预测时间间隔（单位：分钟）
FORECAST_INTERVAL_MINUTES=60
# 用于预测的历史数据天数
FORECAST_HISTORY_DAYS=30
# 默认预测算法：moving_average（移动平均）, linear_regression（线性回归）, arima（时间序列）
FORECAST_ALGORITHM=moving_average
# 是否自动更新预测（定时任务）
FORECAST_AUTO_UPDATE=True

# ==================== LSTM预测配置 ====================
# 是否启用LSTM深度学习预测（需要安装TensorFlow）
FORECAST_LSTM_ENABLED=True
# LSTM输入序列长度（单位：小时）
FORECAST_LSTM_SEQUENCE_LENGTH=24
# LSTM层单元数（逗号分隔，如：64,32 表示两层LSTM，第一层64单元，第二层32单元）
FORECAST_LSTM_UNITS=64,32
# LSTM训练轮数（epochs）
FORECAST_LSTM_EPOCHS=50

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_RETENTION_DAYS=7

# ==================== 服务器配置 ====================
HOST=0.0.0.0
PORT=8088
WORKERS=1
RELOAD=False  # 生产环境设为 Fals

# ==================== 配置文件路径 ====================
CONFIG_DIR=config
# SETTINGS_JSON_PATH=config/settings.json  # 可选
