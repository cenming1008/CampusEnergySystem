# ============================================
# 园区综合能源管理系统 - 环境变量配置模板
# ============================================
# 使用方法：
# 1. 复制此文件为 .env
# 2. 根据实际情况修改配置值
# 3. 注意：.env 文件不要提交到版本控制系统！
# ============================================

# ==================== 应用基础配置 ====================
APP_NAME=园区综合能源管理系统
APP_VERSION=2.0.0
APP_ENV=development
DEBUG=False
STRICT_STARTUP_CHECKS=True

# ==================== 数据库配置 ====================
# 格式：postgresql://用户名:密码@主机:端口/数据库名
# 示例：postgresql://admin:password123@db:5432/campus_energy
DATABASE_URL=postgresql://admin:password123@db:5432/campus_energy
DB_AUTO_CREATE_TABLES=True
DB_RUNTIME_SCHEMA_SYNC=True

# ==================== Redis配置 ====================
# 格式：redis://[:密码@]主机:端口/数据库编号
# 示例：redis://redis:6379/0
REDIS_URL=redis://redis:6379/0
# REDIS_PASSWORD=your_redis_password  # 可选

# ==================== MQTT配置 ====================
MQTT_BROKER=mqtt
MQTT_PORT=1883
MQTT_USERNAME=campus_mqtt
MQTT_PASSWORD=campus_mqtt_secret_2026
MQTT_TOPIC=campus/telemetry
MQTT_TOPIC_WILDCARD=campus/device/+/telemetry
MQTT_CONTROL_TOPIC_PREFIX=campus/control/
MQTT_RETRY_MAX_ATTEMPTS=3
MQTT_RETRY_BACKOFF_SECONDS=60

# ==================== JWT认证配置 ====================
# ⚠️ 重要：生产环境必须修改 SECRET_KEY！
# 建议使用以下命令生成强密钥：
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=300

# ==================== CORS配置 ====================
# 允许的前端来源（JSON数组格式或逗号分隔）
# 开发环境示例：["http://localhost:5173", "http://127.0.0.1:5173"]
# 生产环境示例：["https://yourdomain.com"]
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ==================== 电价配置 ====================
# 用于能耗成本计算（单位：元/kWh）
PEAK_PRICE=1.25
FLAT_PRICE=0.80
VALLEY_PRICE=0.40

# ==================== 故障诊断配置（FDD） ====================
# 电压波动阈值（单位：百分比，如0.10表示10%）
FDD_VOLTAGE_FLUCTUATION_LIMIT=0.10
# 负载率阈值（0-1之间，如0.90表示90%）
FDD_OVERLOAD_RATIO=0.90
# 设备额定功率（单位：kW，用于计算负载率）
FDD_RATED_POWER=1000.0
# 报警次数阈值（超过此值将影响健康评分）
FDD_ALARM_THRESHOLD=10
# 频繁启动次数阈值（单位时间内启动次数）
FDD_FREQUENT_START_COUNT=5

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_RETENTION_DAYS=7

# ==================== 数据清理配置 ====================
# 开发环境建议使用短保留，避免 MQTT 联调与审计流水持续膨胀
ENABLE_AUTO_CLEANUP=true
MQTT_INGESTION_RETENTION_DAYS=3
AUDIT_EVENT_RETENTION_DAYS=3
DATA_RETENTION_DAYS=7
ALARM_RETENTION_DAYS=180
STATISTICS_RETENTION_DAYS=365

# ==================== 服务器配置 ====================
HOST=0.0.0.0
PORT=8088
WORKERS=1
RELOAD=False  # 生产环境设为 Fals

# ==================== 配置文件路径 ====================
CONFIG_DIR=config
# SETTINGS_JSON_PATH=config/settings.json  # 可选
