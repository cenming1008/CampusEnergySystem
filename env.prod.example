# ============================================
# 生产环境配置模板
# ============================================
# 使用方法：
# 1. 复制此文件为 .env.prod
# 1.1 可先运行: python scripts/python/generate_prod_secrets.py
# 2. 修改所有配置值（特别是密码和密钥）
# 3. 使用命令: docker-compose -f docker-compose.prod.yml --env-file .env.prod up -d
# ============================================

# ==================== 数据库配置 ====================
DB_USER=admin
# ⚠️ 必须修改：使用强密码（至少16位）
DB_PASSWORD=ChangeThis_DbPass_24Chars!

# ==================== Redis配置 ====================
# ⚠️ 必须修改：使用强密码（至少16位）
REDIS_PASSWORD=ChangeThis_RedisPass_24!

# ==================== JWT认证配置 ====================
# ⚠️ 必须修改：使用以下命令生成强密钥
# python scripts/python/generate_prod_secrets.py
SECRET_KEY=ChangeThisSecretKey_Jx8m4Y9k2Qp7n3Vt5Lw0Hs6Fa1Rb8Uc

# ==================== Grafana 配置 ====================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeThis_GrafanaPass_24!

# ==================== CORS配置 ====================
# 生产环境域名（JSON数组格式）
# 示例：["https://energy.yourcompany.com","https://dashboard.yourcompany.com"]
CORS_ORIGINS=["https://energy.mine-energy.local"]
TRUSTED_HOSTS=["api.mine-energy.local","energy.mine-energy.local"]
FORCE_HTTPS=True

# ==================== WebSocket 与监控访问 ====================
WEBSOCKET_AUTH_MODE=query_token
MONITORING_ACCESS_MODE=internal_or_jwt
MONITORING_ACCESS_ROLES=["admin","maintainer"]

# ==================== 运行时告警通知（可选） ====================
ALERTING_ENABLED=False
ALERTING_PROJECT_NAME=MineEnergySystem
# ALERTING_WEBHOOK_URL=https://hooks.example.com/services/xxx
ALERTING_EMAIL_ENABLED=False
# ALERTING_SMTP_HOST=smtp.example.com
# ALERTING_SMTP_PORT=587
# ALERTING_SMTP_USERNAME=mine-alert@example.com
# ALERTING_SMTP_PASSWORD=change-me
# ALERTING_EMAIL_FROM=mine-alert@example.com
# ALERTING_EMAIL_TO=["ops@example.com","sre@example.com"]

# ==================== Alertmanager 正式通知通道（二选一） ====================
# 上线前请至少执行一次:
# python scripts/python/check_production_readiness.py --env-file .env.prod
# python scripts/python/send_test_alert.py
ALERTMANAGER_CHANNEL=webhook
ALERTMANAGER_WEBHOOK_URL=https://hooks.invalid/mine-energy-alertmanager
# ALERTMANAGER_CHANNEL=email
# ALERTMANAGER_EMAIL_TO=ops@example.com
# ALERTMANAGER_EMAIL_FROM=mine-alert@mine-energy.local
# ALERTMANAGER_SMARTHOST=smtp.mine-energy.local:587
# ALERTMANAGER_AUTH_USERNAME=mine-alert@mine-energy.local
# ALERTMANAGER_AUTH_PASSWORD=change-me

# ==================== MQTT配置 ====================
# ⚠️ 必须配置：Mosquitto 已启用密码认证
MQTT_USERNAME=mine_mqtt
MQTT_PASSWORD=ChangeThis_MqttPass_24Chars!
MQTT_RETRY_MAX_ATTEMPTS=3
MQTT_RETRY_BACKOFF_SECONDS=60

# ==================== 应用配置 ====================
APP_NAME=煤矿综合能源管理系统
APP_VERSION=2.0.0
APP_ENV=production
DEBUG=False
LOG_LEVEL=INFO
STRICT_STARTUP_CHECKS=True
DB_AUTO_CREATE_TABLES=False
DB_RUNTIME_SCHEMA_SYNC=False

# ==================== 电价配置 ====================
# ⚠️ 请按现场实际电价配置，默认值为开发占位数据
PEAK_PRICE=1.25
FLAT_PRICE=0.80
VALLEY_PRICE=0.40

# ==================== 故障诊断配置 ====================
# ⚠️ 请按现场实际设备参数配置
# FDD_RATED_POWER=1000.0
# FDD_OVERLOAD_RATIO=0.90
# FDD_VOLTAGE_FLUCTUATION_LIMIT=0.10
