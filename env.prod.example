# ============================================
# 生产环境配置模板
# ============================================
# 使用方法：
# 1. 复制此文件为 .env.prod
# 2. 修改所有配置值（特别是密码和密钥）
# 3. 使用命令: docker-compose -f docker-compose.prod.yml --env-file .env.prod up -d
# ============================================

# ==================== 数据库配置 ====================
DB_USER=admin
# ⚠️ 必须修改：使用强密码（至少16位）
DB_PASSWORD=your-strong-database-password-change-me-min-16-chars

# ==================== Redis配置 ====================
# ⚠️ 必须修改：使用强密码（至少16位）
REDIS_PASSWORD=your-strong-redis-password-change-me-min-16-chars

# ==================== JWT认证配置 ====================
# ⚠️ 必须修改：使用以下命令生成强密钥
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-jwt-key-min-32-chars-change-me-immediately

# ==================== CORS配置 ====================
# 生产环境域名（JSON数组格式）
# 示例：["https://energy.yourcompany.com","https://dashboard.yourcompany.com"]
CORS_ORIGINS=["https://energy.yourcompany.com"]

# ==================== MQTT配置（可选） ====================
# 如需启用MQTT认证，取消注释并配置
# MQTT_USERNAME=admin
# MQTT_PASSWORD=your-mqtt-password-change-me

# ==================== 应用配置 ====================
APP_NAME=煤矿综合能源管理系统
APP_VERSION=2.0.0
DEBUG=False
LOG_LEVEL=INFO

# ==================== 电价配置（可选） ====================
# PEAK_PRICE=1.25
# FLAT_PRICE=0.80
# VALLEY_PRICE=0.40
